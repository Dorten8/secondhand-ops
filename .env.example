# ==============================================================================
# secondhand-ops — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit your `.env` file to version control.
# ==============================================================================

# LLM Providers (for automated intake, photo analysis, draft generation)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Registry / Storage Configuration
# Path to shared atomic WAL items.json registry (defaults to /opt/data/marketplace/items.json)
MARKETPLACE_REGISTRY=/opt/data/marketplace/items.json

# Optional: Notion SSoT Integration
# If configured, operations will sync with your private Notion database.
# If omitted or left empty, the engine operates in standalone local WAL mode.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Browser Automation & Chrome DevTools Protocol (CDP)
# CDP endpoint for running browser instances (e.g. Brave or Chrome with --remote-debugging-port=9222)
CDP_URL=http://127.0.0.1:9222

# Seller Contact & Default Pickup Terms
SELLER_LOCATION_POSTAL="2300 København S"
SELLER_PAYMENT_METHODS="MobilePay, Cash"

# Pickup confirmation block (conversations lane)
# Sent verbatim once a pickup time is agreed. The code refuses to send a partial
# block, so these two are REQUIRED before any confirmation can go out.
PICKUP_MAP=https://maps.app.goo.gl/your_link_here
PICKUP_PHONE=00000000
# Wording of the phone line, per language. Danish buyer -> _DA, English -> _EN.
PICKUP_PHONE_NOTE_DA=ring hvis jeg ikke svarer
PICKUP_PHONE_NOTE_EN=call me if I'm not replying

# Where the Hermes env file lives, when these values are read from a file rather
# than the process environment (cron jobs do not inherit a shell).
HERMES_ENV_FILE=/home/hermes/hermes/home/.env

# Notification Endpoints (used by messaging/notify.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
DISCORD_WEBHOOK_URL=

# Delivery routing (comms lane)
# TELEGRAM_CHAT_ID is the group; topics are thread ids inside it.
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_INBOX=13
# Audit log of every message a script posted and where it landed.
SAY_LOG=/home/hermes/hermes/home/deliveries.jsonl
# Optional: a file holding a bot token, instead of TELEGRAM_BOT_TOKEN in the env.
TG_TOKEN_FILE=
