# ==============================================================================
# secondhand-ops — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit your `.env` file to version control.
# ==============================================================================

# LLM Providers (for automated intake, photo analysis, draft generation)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Registry / Storage Configuration
# Path to shared atomic WAL items.json registry (defaults to /opt/data/marketplace/items.json)
MARKETPLACE_REGISTRY=/opt/data/marketplace/items.json

# Optional: Notion SSoT Integration
# If configured, operations will sync with your private Notion database.
# If omitted or left empty, the engine operates in standalone local WAL mode.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Browser Automation & Chrome DevTools Protocol (CDP)
# CDP endpoint for running browser instances (e.g. Brave or Chrome with --remote-debugging-port=9222)
CDP_URL=http://127.0.0.1:9222

# Seller Contact & Default Pickup Terms
SELLER_LOCATION_POSTAL="2300 København S"
SELLER_PAYMENT_METHODS="MobilePay, Cash"

# Notification Endpoints (used by messaging/notify.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
DISCORD_WEBHOOK_URL=
