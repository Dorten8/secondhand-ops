#!/usr/bin/env python3
"""bin/msgctl — thin entry point for the conversations stage.

All logic lives in src/conversations/msgctl.py; this only fixes the import path
so the CLI can be called from the repo root without installing the package.

    python3 bin/msgctl pending
    python3 bin/msgctl approve --id 7 --action send --by Jacob
"""
import sys
from pathlib import Path

SRC = Path(__file__).resolve().parent.parent / "src"
sys.path.insert(0, str(SRC))
sys.path.insert(0, str(SRC / "conversations"))

from conversations.msgctl import main  # noqa: E402

if __name__ == "__main__":
    main()
